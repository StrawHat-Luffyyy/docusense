NODE_ENV=development
PORT=4000
ALLOW_ORIGINS=http://localhost:3000

# Database Connection URL (Prisma / Postgres)
# - Local DB: postgresql://user:password@localhost:5432/docusense
# - Render (External URL for local CLI / migrations): postgresql://user:password@dpg-xxxx-a.oregon-postgres.render.com/dbname?sslmode=require
# - Render (Internal URL for production backend service): postgresql://user:password@dpg-xxxx-a/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/docusense
REDIS_URL=redis://localhost:6379

# Clerk Authentication (optional for development)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

